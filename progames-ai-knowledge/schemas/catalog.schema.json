{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ProGames source grounded catalog",
  "type": "object",
  "required": [
    "schema_version",
    "as_of",
    "products"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "as_of": {
      "type": "string"
    },
    "scope": {
      "type": "string"
    },
    "products": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "category",
          "relationship",
          "manufacturer",
          "short_description",
          "applications",
          "features",
          "options",
          "colors",
          "technical_specifications",
          "official_url",
          "polish_url",
          "source_ids",
          "verified_at",
          "approval_status",
          "confidence",
          "evidence",
          "legacy_source_url_unverified",
          "source_copy_status_unverified",
          "availability",
          "price",
          "certifications"
        ],
        "properties": {
          "id": {
            "type": [
              "string",
              "null"
            ]
          },
          "name": {
            "type": [
              "string",
              "null"
            ]
          },
          "category": {
            "type": [
              "string",
              "null"
            ]
          },
          "relationship": {
            "enum": [
              "distributed",
              "manufacturer_site_catalogue"
            ]
          },
          "manufacturer": {
            "type": [
              "string",
              "array",
              "object",
              "number",
              "null"
            ]
          },
          "short_description": {
            "type": [
              "string",
              "null"
            ]
          },
          "applications": {
            "type": [
              "array",
              "null"
            ],
            "items": {
              "type": "string"
            }
          },
          "features": {
            "type": [
              "array",
              "null"
            ],
            "items": {
              "type": "string"
            }
          },
          "options": {
            "type": [
              "array",
              "null"
            ],
            "items": {
              "type": "string"
            }
          },
          "colors": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "id",
                "name",
                "image"
              ],
              "properties": {
                "id": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "name": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "image": {
                  "type": [
                    "string",
                    "null"
                  ]
                }
              }
            }
          },
          "technical_specifications": {
            "type": [
              "object",
              "null"
            ],
            "additionalProperties": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "official_url": {
            "type": [
              "string",
              "null"
            ]
          },
          "polish_url": {
            "type": [
              "string",
              "null"
            ]
          },
          "source_ids": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "verified_at": {
            "type": [
              "string",
              "null"
            ]
          },
          "approval_status": {
            "enum": [
              "source_verified_human_pending",
              "human_approved",
              "rejected"
            ]
          },
          "confidence": {
            "type": [
              "string",
              "null"
            ]
          },
          "evidence": {
            "type": "object"
          },
          "legacy_source_url_unverified": {
            "type": [
              "string",
              "null"
            ]
          },
          "source_copy_status_unverified": {
            "type": [
              "string",
              "null"
            ]
          },
          "availability": {
            "type": [
              "string",
              "array",
              "object",
              "number",
              "null"
            ]
          },
          "price": {
            "type": [
              "string",
              "array",
              "object",
              "number",
              "null"
            ]
          },
          "certifications": {
            "type": [
              "string",
              "array",
              "object",
              "number",
              "null"
            ]
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
